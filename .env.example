# Server-side values must never reach a client bundle. Only VITE_* values below
# are intentionally embedded into the built client by Vite.
# The server auto-loads this file (./.env) on boot.
# Required in production. Local dev can omit it, but live translation will fail.
GEMINI_API_KEY=your-gemini-api-key
# Optional in local dev — defaults to "admin" with a warning.
# Required in production; use at least 16 random characters.
ADMIN_SECRET=replace-with-a-long-random-secret
# Local dev defaults (Render production uses the persistent disk at /data)
DATABASE_PATH=./data/app.db
UPLOADS_DIR=./data/uploads
PORT=3010
# Recommended in production: the browser-visible app origin. The server also
# rejects same-host HTML decks from the request Host header.
# PUBLIC_ORIGIN=https://talk.example.com
# Set true only when the app is behind a trusted reverse proxy that owns
# X-Forwarded-For; leave false/empty for direct exposure.
# TRUST_PROXY=false
# Optional cleanup TTL for inactive trial records; live trial runtime is fixed
# at 3 minutes and auto-ends separately. Defaults to 2 hours.
# TRIAL_TTL_MS=7200000
# Concurrent-viewer cap per normal (non-trial) session. Bounds memory on a
# single instance. Defaults to 500; set 0 for unlimited (not recommended).
# MAX_VIEWERS_PER_SESSION=500
# Per-IP public read ceiling for shared audience NATs. Defaults to 2000/min.
# PUBLIC_GET_MAX=2000
# Optional error reporting. When set, the server initializes Sentry if the
# optional @sentry/node package is installed (npm i @sentry/node -w server).
# SENTRY_DSN=
# Test-only control hooks (e.g. kill_gemini_test). Ignored in production
# regardless of this value; defaults to off.
# ENABLE_TEST_HOOKS=false
# Validate visitor-supplied Gemini keys before creating own-key trials.
# Keep enabled in production; tests can set false to avoid external calls.
# VALIDATE_TRIAL_GEMINI_KEYS=true

# Audio/caption sync flags. When SFU audio is active, server metadata defaults
# on; the client synced path is also on unless explicitly set to false/0.
# AUDIO_SYNC_METADATA=false
# VITE_AUDIO_SYNC_V2=false

# Optional client build-time analytics. When unset, Google Analytics is not
# loaded. When set, only sanitized SPA page categories are sent.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Operator-paid translated audio gate. When false, viewers still get captions
# and slides, but /audio/subscribe returns 403 and viewer audio is hidden.
# AUDIO_SUBSCRIPTION_ACTIVE=false
# Cloudflare Realtime SFU credentials for viewer audio fanout. Required when
# AUDIO_SUBSCRIPTION_ACTIVE=true in production. Use the SFU app secret for this
# app id. If you paste "Bearer ..." or "Authorization: Bearer ...", the server
# strips the prefix before sending Cloudflare requests.
# CF_REALTIME_APP_ID=
# CF_REALTIME_APP_SECRET=
# Compatibility alias for deployments that already use the older variable name:
# CF_REALTIME_APP_TOKEN=
# CF_REALTIME_API_BASE=https://rtc.live.cloudflare.com/v1

# Optional R2 storage for uploaded PDFs. If any account/key/bucket value is
# missing, PDFs stay in UPLOADS_DIR.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Optional public R2/CDN base for direct PDF delivery. Must allow browser GETs
# from the app origin (CORS). If unset, PDFs are served through /uploads.
# R2_PUBLIC_BASE_URL=https://cdn.example.com
# Optional: build client hashed assets with this CDN base and run
# `npm run upload:assets` after `npm run build`.
# ASSET_CDN_BASE_URL=https://cdn.example.com
